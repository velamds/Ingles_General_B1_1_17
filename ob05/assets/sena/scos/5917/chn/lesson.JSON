"stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "audio", "value": "engenn6le17ob05re5aud01"}], "template_override": 1, "title": "", "type": "text", "id": 2, "_data": []}, {"contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "id": 0, "text": ""}, {"time": "100", "image": "", "id": 1, "text": "You'd probably feel kind of silly jumping around the floor, flapping your arms and legs and shaking your head and body. But if you were doing it to music, you'd be dancing! Throughout history, dancing has been a way for people to express themselves physically and emotionally."}, {"time": "14000", "image": "", "id": 2, "text": "Ballroom dancing began in England in the late 1700s. The upper classes of England used to dance at social events called balls. By the early 1800s, people of all social groups would dance in public halls around the world. Ballroom dancing has become extremely popular throughout the world. If you have done the waltz, foxtrot, samba, cha-cha, or rumba, then you have gone ballroom dancing!   Disco dancing began in the 1970s. It used to be very popular in dance clubs in New York City."}, {"time": "43500", "image": "", "id": 3, "text": "It's easy to understand why any kind of dancing is so popular. It makes people feel good, it's fun, and it's great exercise. It's never too hard to find a place to go to express yourself through dancing."}], "video_src": "engenn6le17ob05re2vid01"}}], "template_override": 1, "title": "", "type": "video", "id": 3, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Leisure Time"}, {"type": "unit_name", "content": "A Brief History of Dancing"}, {"type": "position", "content": 5}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 17}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": " Describe  routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"contents": [{"type": "name", "content": "ballroom dancing"}, {"type": "definition", "content": "a series of popular dances between two people"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Ballroom dancing began in England in the late 1700s. "}, {"type": "audio", "content": "engenn6le17ob05aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use when you talk about dancing."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "ball"}, {"type": "definition", "content": "a formal social gathering that involves dancing"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The upper classes of England used to dance at social events called balls. "}, {"type": "audio", "content": "engenn6le17ob05aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "dance hall "}, {"type": "definition", "content": "traditionally, a large room for dancing, open to the public "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: People of all social groups would dance in public dance halls around the world."}, {"type": "audio", "content": "engenn6le17ob05aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "club"}, {"type": "definition", "content": "the modern way to talk about a place for dancing"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Disco used to be very popular in dance clubs. "}, {"type": "audio", "content": "engenn6le17ob05aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "waltz"}, {"type": "definition", "content": "a type of dance using triple time (1, 2, 3 \u2026 1, 2, 3 \u2026)"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: If you have ever done the waltz, then you have done ballroom dancing!  "}, {"type": "audio", "content": "engenn6le17ob05aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "disco"}, {"type": "definition", "content": "a type of dance that became popular in the 1970s."}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Disco dancing used to be very popular in New York City. "}, {"type": "audio", "content": "engenn6le17ob05aud06"}], "type": "target_word"}, {"type": "background_image", "content": "engenn6le17ob05re1img01.jpg"}, {"contents": [{"type": "heading", "content": " Used To and Would for Past Habits"}, {"type": "describer", "content": " <span class = strong>Used to</span> and  <span class = strong>would</span> are both used to talk about past actions."}, {"type": "text", "content": "We use  <span class = strong>used to</span> to express something that we often did in the past, but don't do anymore. It is often used to talk about something that was a habit, or a way of life in the past. We we it to contrast past habits with present situations.  <span class = strong>Used to</span>  can refer to situations as well as habitual actions.  We use  <span class = strong>would</span> refers to past actions and habits as well.  <span class = strong>Would</span> only refers to actions, but not situations."}, {"type": "example", "content": "The upper classes of England used to dance at social events called balls. "}, {"type": "example", "content": "By the early 1800s, people of all social groups would dance in public dance halls around the world."}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Present Perfect Tense to Talk About Experiences"}, {"type": "describer", "content": "You use the Present Perfect tense to talk about a finished action or event that is connected to the present in some way. "}, {"type": "text", "content": "You can use the Present Perfect tense to talk about experience. When you use the Present Perfect tense, you think about the past and present together. There is some connection between what happened in the past and now. "}, {"type": "text", "content": "<li><span class = italic>I have learned English</span> = I learned English in the past and now I can speak English. </li>"}, {"type": "text", "content": "<li><span class = italic>He has bought a painting</span>  = He bought the painting in the past and now he has a painting. </li>"}, {"type": "text", "content": "We use <span class = strong>have/has + the past participle</span> of the verb in Present Perfect sentences."}, {"type": "text", "content": "Look at the chart about how to form the Present Perfect tense:"}, {"type": "table", "content": "{\"rows\":4,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Main Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Past Tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Past Participle \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Present Perfect Tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" be\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" been\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Dancing has always been...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" become\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" became\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" became\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Disco has become...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"do\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"did\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"done\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" If you have done...\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": "Dancing has always been a way for people to express themselves physically and emotionally. "}, {"type": "example", "content": "Ballroom dancing has become extremely popular throughout the world. "}, {"type": "text", "content": "It is important to note that you cannot use specific time expressions <span class=\"italic\">last year</span> or <span class=\"italic\">when I was a child</span> with the Past Continuous tense. <br/>However, you can use expressions that do not specify that time, like <span class=\"italic\">often</span> or  <span class=\"italic\">already</span>.<br/>Incorrect: <span class=\"italic\">Last year, I've eaten cake</span><br/>Correct: <span class=\"italic\">I've already eaten cake.</span>"}], "type": "learning_points"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Choose two or more of the dances mentioned in this lesson."}, {"type": "text", "content": "Go online. Find a video showing people doing or talking about each dance."}, {"type": "text", "content": "Write a paragraph explaining the difference between the dances. You can discuss the music, use of hands, use of feet, etc."}, {"type": "text", "content": "Present the information to a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I watch two or more videos on different dances. "}, {"type": "text", "content": "I write a paragraph comparing the dances."}, {"type": "text", "content": "I read the paragraph to a partner."}]}]}